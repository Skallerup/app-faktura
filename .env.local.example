# Gmail-konto der sender billagene (din Gmail-adresse)
GMAIL_USER=din@gmail.com

# Gmail App Password (ikke dit normale password)
# Aktiver 2-faktor login på din Google-konto, gå til:
# Google Konto → Sikkerhed → App-adgangskoder → Opret ny → "Mail" → "Windows-computer"
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
